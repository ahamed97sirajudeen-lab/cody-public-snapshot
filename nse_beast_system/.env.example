# NSE Beast System - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in with your actual values
# DO NOT commit .env to version control!
# ============================================================================

# ============================================================================
# ZERODHA KITECONNECT CREDENTIALS
# ============================================================================

# Zerodha API Key
# Get from: https://kite.zerodha.com/settings/api/applications
ZERODHA_API_KEY=your_api_key_here

# Zerodha API Secret
# Get from: https://kite.zerodha.com/settings/api/applications
ZERODHA_API_SECRET=your_api_secret_here

# Zerodha Access Token (obtained after login)
# Generated during authentication flow
ZERODHA_ACCESS_TOKEN=your_access_token_here

# Zerodha Request Token (temporary, used for initial login)
# Obtained from redirect after user login
ZERODHA_REQUEST_TOKEN=your_request_token_here

# Zerodha User ID (email or username)
# Your Zerodha account login
ZERODHA_USER_ID=your_user_id_here

# Zerodha Public Token (persistent, for future sessions)
# Save this to avoid re-authentication
ZERODHA_PUBLIC_TOKEN=your_public_token_here

# ============================================================================
# ENGINE CONFIGURATION
# ============================================================================

# Enable live trading (true/false)
# Set to false for paper trading/backtesting
ENABLE_LIVE_TRADING=false

# Engine mode (live/paper/backtest)
ENGINE_MODE=paper

# Trading time zone
TRADING_TIMEZONE=Asia/Kolkata

# Market open time (HH:MM format)
MARKET_OPEN_TIME=09:15

# Market close time (HH:MM format)
MARKET_CLOSE_TIME=15:30

# Pre-market open time (HH:MM format)
PREMARKET_OPEN_TIME=09:00

# ============================================================================
# RISK MANAGEMENT
# ============================================================================

# Maximum number of concurrent positions
MAX_POSITIONS=5

# Maximum position size (in units/contracts)
MAX_POSITION_SIZE=10

# Maximum daily loss (stop trading if exceeded)
# Negative value indicates loss
MAX_DAILY_LOSS=-5000

# Maximum daily profit (close all positions if exceeded)
MAX_DAILY_PROFIT=50000

# Maximum position hold time (in hours)
POSITION_TIMEOUT_HOURS=4

# Stop loss percentage (negative value)
STOP_LOSS_PERCENTAGE=-2.0

# Take profit percentage (positive value)
TAKE_PROFIT_PERCENTAGE=3.0

# Maximum trades per hour
MAX_TRADES_PER_HOUR=10

# Kill switch: immediate shutdown on loss threshold
KILL_SWITCH_LOSS_THRESHOLD=-10000

# Kill switch: emergency exit all positions
ENABLE_KILL_SWITCH=true

# ============================================================================
# VRP (VOLATILITY RISK PREMIUM) SETTINGS
# ============================================================================

# Minimum VRP score to generate signals (0-1)
MIN_VRP_SCORE=0.60

# VRP calculation method (historical/implied/blended)
VRP_CALCULATION_METHOD=blended

# Historical volatility lookback period (days)
VRP_HISTORICAL_LOOKBACK=30

# Implied volatility source (exchange/model)
VRP_IV_SOURCE=exchange

# VRP threshold for strong signals
VRP_STRONG_SIGNAL_THRESHOLD=0.75

# VRP threshold for weak signals
VRP_WEAK_SIGNAL_THRESHOLD=0.50

# ============================================================================
# REGIME DETECTION SETTINGS
# ============================================================================

# Minimum regime confidence (0-1)
MIN_REGIME_CONFIDENCE=0.65

# Regime detection method (sma/ema/adx/macd)
REGIME_DETECTION_METHOD=adx

# Trend lookback period (bars)
REGIME_LOOKBACK_PERIOD=20

# ADX threshold for strong trend
ADX_STRONG_TREND_THRESHOLD=25

# ADX threshold for weak trend
ADX_WEAK_TREND_THRESHOLD=20

# Current regime (trending/ranging/volatile)
CURRENT_MARKET_REGIME=ranging

# ============================================================================
# SIGNAL GENERATION SETTINGS
# ============================================================================

# Signal expiry time (minutes)
SIGNAL_EXPIRY_MINUTES=5

# Enable short selling
ENABLE_SHORT_SELLING=true

# Enable options trading
ENABLE_OPTIONS_TRADING=true

# Preferred option strategies (comma-separated)
# Valid: long_call, long_put, short_call, short_put, straddle, strangle, iron_condor, bull_call_spread
PREFERRED_STRATEGIES=short_call,short_put,iron_condor

# Strike selection: ATM/OTM/ITM
STRIKE_SELECTION_PREFERENCE=OTM

# Options expiry preference (weekly/monthly)
OPTIONS_EXPIRY_PREFERENCE=weekly

# Minimum option premium for entry (in points)
MIN_OPTION_PREMIUM=10

# ============================================================================
# EXECUTION SETTINGS
# ============================================================================

# Order type (MARKET/LIMIT/SL/SL-M)
DEFAULT_ORDER_TYPE=MARKET

# Order timeout (seconds)
ORDER_TIMEOUT_SECONDS=30

# Maximum order retry attempts
ORDER_RETRY_ATTEMPTS=3

# Retry delay (milliseconds)
ORDER_RETRY_DELAY_MS=500

# Enable partial fills
ALLOW_PARTIAL_FILLS=true

# Slippage tolerance (%)
SLIPPAGE_TOLERANCE_PERCENT=0.5

# Price impact limit (%)
PRICE_IMPACT_LIMIT_PERCENT=1.0

# ============================================================================
# POSITION MANAGEMENT
# ============================================================================

# Rebalancing frequency (minutes)
REBALANCING_FREQUENCY_MINUTES=30

# Correlation limit for position pairs
MAX_POSITION_CORRELATION=0.7

# Delta hedge target
DELTA_HEDGE_TARGET=0.3

# Gamma management threshold
GAMMA_MANAGEMENT_THRESHOLD=0.5

# Vega limit (portfolio exposure)
MAX_VEGA_EXPOSURE=5000

# Theta target (daily decay goal)
THETA_TARGET_PER_DAY=500

# ============================================================================
# EXIT STRATEGY SETTINGS
# ============================================================================

# Time-based exit after hours
EXIT_AFTER_HOURS=4

# Volatility-based exit threshold (%)
EXIT_VOLATILITY_THRESHOLD=30

# Correlation breakdown threshold
EXIT_CORRELATION_BREAKDOWN_THRESHOLD=0.5

# Technical exit signals (true/false)
ENABLE_TECHNICAL_EXITS=true

# News-based exits (requires API integration)
ENABLE_NEWS_EXITS=false

# Price action exits (true/false)
ENABLE_PRICE_ACTION_EXITS=true

# ============================================================================
# MONITORING & ALERTING
# ============================================================================

# Log level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# Logging directory
LOG_DIR=logs

# Enable console logging
ENABLE_CONSOLE_LOGGING=true

# Enable file logging
ENABLE_FILE_LOGGING=true

# Enable JSON telemetry
ENABLE_JSON_TELEMETRY=true

# Telemetry file path
TELEMETRY_FILE=logs/telemetry.json

# Heartbeat interval (seconds)
HEARTBEAT_INTERVAL_SECONDS=5

# Metrics update interval (seconds)
METRICS_UPDATE_INTERVAL_SECONDS=10

# Trade check interval (seconds)
TRADE_CHECK_INTERVAL_SECONDS=1

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL_SECONDS=10

# Alert email recipients (comma-separated)
ALERT_EMAIL_RECIPIENTS=your-email@example.com

# Telegram bot token (for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram chat ID (for alerts)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database type (sqlite/postgresql/mysql/mongodb)
DATABASE_TYPE=sqlite

# SQLite database path
SQLITE_DB_PATH=data/beast_engine.db

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
POSTGRESQL_URL=postgresql://user:password@localhost:5432/beast_engine

# MySQL connection string
# Format: mysql+pymysql://user:password@host:port/database
MYSQL_URL=mysql+pymysql://user:password@localhost:3306/beast_engine

# MongoDB connection string
# Format: mongodb://user:password@host:port/database
MONGODB_URL=mongodb://localhost:27017/beast_engine

# ============================================================================
# REDIS CONFIGURATION (Optional: for caching & pub/sub)
# ============================================================================

# Redis enabled
REDIS_ENABLED=false

# Redis URL
# Format: redis://[:password]@host:port/db
REDIS_URL=redis://localhost:6379/0

# Redis password (if required)
REDIS_PASSWORD=

# Redis connection timeout (seconds)
REDIS_TIMEOUT_SECONDS=5

# Redis cache TTL (seconds)
REDIS_CACHE_TTL_SECONDS=3600

# ============================================================================
# EXTERNAL DATA FEEDS
# ============================================================================

# Alpha Vantage API key (for equity data)
ALPHA_VANTAGE_API_KEY=

# IEX Cloud API key (for stock data)
IEX_CLOUD_API_KEY=

# Yahoo Finance enabled (true/false)
YAHOO_FINANCE_ENABLED=true

# Quandl API key (for alternative data)
QUANDL_API_KEY=

# ============================================================================
# BACKTESTING SETTINGS
# ============================================================================

# Backtest start date (YYYY-MM-DD)
BACKTEST_START_DATE=2023-01-01

# Backtest end date (YYYY-MM-DD)
BACKTEST_END_DATE=2023-12-31

# Backtest initial capital
BACKTEST_INITIAL_CAPITAL=100000

# Backtest commission per trade
BACKTEST_COMMISSION_PER_TRADE=20

# Backtest slippage (%)
BACKTEST_SLIPPAGE_PERCENT=0.1

# Number of backtest iterations
BACKTEST_ITERATIONS=100

# ============================================================================
# PERFORMANCE MONITORING
# ============================================================================

# Sentry DSN (for error tracking)
SENTRY_DSN=

# Prometheus enabled
PROMETHEUS_ENABLED=false

# Prometheus port
PROMETHEUS_PORT=8000

# Performance logging enabled
PERFORMANCE_LOGGING_ENABLED=true

# Trade roundtrip analysis enabled
TRADE_ROUNDTRIP_ANALYSIS=true

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================

# Slack webhook for notifications
SLACK_WEBHOOK_URL=

# Discord webhook for notifications
DISCORD_WEBHOOK_URL=

# Email SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Notification types to enable (comma-separated)
# Options: trade_entry, trade_exit, daily_pnl, alerts, errors
ENABLED_NOTIFICATIONS=trade_entry,trade_exit,alerts,errors

# ============================================================================
# STRATEGY CONFIGURATION
# ============================================================================

# Primary strategy (e.g., iron_condor, strangle, etc.)
PRIMARY_STRATEGY=iron_condor

# Secondary strategy (optional)
SECONDARY_STRATEGY=

# Strategy aggressiveness (conservative/moderate/aggressive)
STRATEGY_AGGRESSIVENESS=moderate

# Trend following enabled
TREND_FOLLOWING_ENABLED=true

# Mean reversion enabled
MEAN_REVERSION_ENABLED=true

# Momentum trading enabled
MOMENTUM_TRADING_ENABLED=true

# Calendar spread enabled
CALENDAR_SPREAD_ENABLED=false

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Enable machine learning predictions
ENABLE_ML_PREDICTIONS=false

# ML model path
ML_MODEL_PATH=models/predictor_model.pkl

# Enable ensemble strategies
ENABLE_ENSEMBLE_STRATEGIES=true

# Number of strategy ensemble members
ENSEMBLE_SIZE=3

# Adaptive position sizing (true/false)
ADAPTIVE_POSITION_SIZING=true

# Dynamic risk adjustment based on market conditions
DYNAMIC_RISK_ADJUSTMENT=true

# Multi-timeframe analysis
ENABLE_MULTI_TIMEFRAME_ANALYSIS=true

# Primary timeframe (minutes)
PRIMARY_TIMEFRAME=5

# Secondary timeframe (minutes)
SECONDARY_TIMEFRAME=15

# ============================================================================
# DEVELOPMENT & DEBUG
# ============================================================================

# Debug mode (verbose logging)
DEBUG_MODE=false

# API request logging
LOG_API_REQUESTS=false

# Trade simulation mode (no actual orders)
SIMULATION_MODE=false

# Dry run mode (connect to broker but don't trade)
DRY_RUN_MODE=false

# Save all trades to CSV
SAVE_TRADES_CSV=true

# Trades CSV path
TRADES_CSV_PATH=data/trades.csv

# Configuration file path
CONFIG_FILE_PATH=config/beast_engine_config.json

# ============================================================================
# SYSTEM RESOURCE LIMITS
# ============================================================================

# Maximum memory usage (MB)
MAX_MEMORY_MB=2048

# Maximum CPU usage (%)
MAX_CPU_PERCENT=80

# Maximum log file size (MB)
MAX_LOG_FILE_SIZE_MB=100

# Maximum number of log backups
LOG_BACKUP_COUNT=10

# ============================================================================
# RECOVERY & FAILOVER
# ============================================================================

# Enable automatic recovery
ENABLE_AUTO_RECOVERY=true

# Recovery mode (reconnect/restart/failover)
RECOVERY_MODE=reconnect

# Failover broker URL (backup broker)
FAILOVER_BROKER_URL=

# Session recovery enabled
SESSION_RECOVERY_ENABLED=true

# Position recovery from database
POSITION_RECOVERY_ENABLED=true

# ============================================================================
# DATA PERSISTENCE
# ============================================================================

# Save trade data frequency (minutes)
TRADE_DATA_SAVE_FREQUENCY_MINUTES=1

# Archive old trades (days)
ARCHIVE_TRADES_AFTER_DAYS=30

# Backup database frequency (hours)
BACKUP_DATABASE_FREQUENCY_HOURS=6

# Data retention period (days)
DATA_RETENTION_DAYS=365

# ============================================================================
# OPTIMIZATION SETTINGS
# ============================================================================

# Use cython for speed-critical operations
USE_CYTHON=false

# Use numba JIT compilation
USE_NUMBA=true

# Parallel processing enabled
PARALLEL_PROCESSING_ENABLED=true

# Number of parallel workers
PARALLEL_WORKERS=4

# Cache strategy calculations
CACHE_STRATEGY_CALCULATIONS=true

# ============================================================================
# API RATE LIMITING
# ============================================================================

# Zerodha API rate limit (requests per minute)
ZERODHA_API_RATE_LIMIT=180

# Order placement rate limit (orders per second)
ORDER_RATE_LIMIT_PER_SECOND=10

# Quote data rate limit (requests per second)
QUOTE_RATE_LIMIT_PER_SECOND=5

# ============================================================================
# COMPLIANCE & AUDIT
# ============================================================================

# Trade audit logging
TRADE_AUDIT_LOGGING=true

# Compliance checks enabled
COMPLIANCE_CHECKS_ENABLED=true

# Transaction audit trail
AUDIT_TRAIL_ENABLED=true

# Regulatory reporting enabled
REGULATORY_REPORTING_ENABLED=false

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
